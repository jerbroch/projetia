{
  "name": "construction-ios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/kill-dev-servers.mjs && node scripts/ensure-clean-dev-manifest.mjs",
    "dev": "PORT=3000 next dev",
    "dev:clean": "node scripts/kill-dev-servers.mjs && rm -rf .next node_modules/.cache && PORT=3000 next dev",
    "dev:reset": "npm run dev:clean",
    "prebuild": "node scripts/check-no-dev-server.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-server-actions.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:css": "node scripts/verify-css-health.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:css && npm run verify:prices",
    "test": "vitest run",
    "supabase:check": "node scripts/test-supabase-admin.mjs",
    "kill-ports": "node scripts/kill-dev-servers.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "node scripts/generate-e2e-report.mjs && playwright show-report e2e/report/html",
    "verify:prices": "tsx scripts/verify-stripe-prices.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@stripe/stripe-js": "^5.5.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.4.4",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
