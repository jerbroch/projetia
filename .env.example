# Database (PostgreSQL)
# Option 1: Set DATABASE_URL directly (Neon, Prisma Postgres, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Option 2: Connect Vercel Postgres or Prisma Postgres from the Vercel Storage tab.
# Vercel injects these automatically — no manual DATABASE_URL needed:
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# DIRECT_URL=

# NextAuth / Auth.js
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
# Set to your production URL on Vercel (e.g. https://your-app.vercel.app)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Stripe (Online Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
