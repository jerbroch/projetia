# Supabase (required for real account registration/login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (quote email links, auth redirects). Must match the port you run `npm run dev` on.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login (optional — enabled automatically in development)
# Set to "true" in production to show "Compte de démonstration" button
DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Demo session signing (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Stripe (Online Payments — existing feature, optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform admin (Super Admin — uses existing Supabase service role)
# No extra env vars required. Grant super admin via SQL (see docs/PLATFORM_EXTENSIONS.md).
# Optional: override test email base when + addressing is unavailable (e.g. qa@yourdomain.com)
# PLATFORM_TEST_EMAIL_BASE=qa@yourdomain.com

# SaaS subscription pricing (choose-plan page — leave unset to show "Prix à configurer")
# SUBSCRIPTION_MONTHLY_PRICE_CENTS=9900
# SUBSCRIPTION_ANNUAL_PRICE_CENTS=99000
# SUBSCRIPTION_ANNUAL_DISCOUNT_PERCENT=20
# SUBSCRIPTION_CURRENCY=cad

# Resend (Quote email delivery — optional, logs link to console if unset)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ConstructionIOS <noreply@votredomaine.com>
