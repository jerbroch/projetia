# Supabase (required for real account registration/login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (quote email links, auth redirects). Must match the port you run `npm run dev` on.
# Production: https://constructionios.com
# Supabase Dashboard → Authentication → URL Configuration must include:
#   Site URL: same as NEXT_PUBLIC_APP_URL
#   Redirect URLs: https://constructionios.com/auth/callback (and localhost for dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo login (optional — enabled automatically in development)
# Set to "true" in production to show "Compte de démonstration" button
DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Demo session signing (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Stripe (paiements clients ET abonnement SaaS)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Secret du endpoint webhook (Stripe Dashboard → Developers → Webhooks)
# Endpoint à déclarer : https://constructionios.com/api/stripe/webhook
# Évènements : checkout.session.completed, customer.subscription.created/updated/deleted,
#              invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs des 4 paliers (Products → prix récurrents, devise CAD).
# VALEURS BIDON — remplacer par les vrais IDs dans .env.local / Vercel.
# Sans ces valeurs, la page /choose-plan enregistre le choix mais n'ouvre pas Checkout.
# Solo — 39,99 $/mois · 399,90 $/an · 1 utilisateur
STRIPE_PRICE_SOLO_MONTHLY=price_xxxxxxxxxxxxxxsolomonth
STRIPE_PRICE_SOLO_ANNUAL=price_xxxxxxxxxxxxxxxsoloyear
# Entreprise — 89,99 $/mois · 899,90 $/an · 5 utilisateurs
STRIPE_PRICE_ENTREPRISE_MONTHLY=price_xxxxxxxxxxxxxentrmonth
STRIPE_PRICE_ENTREPRISE_ANNUAL=price_xxxxxxxxxxxxxxentryear
# Entrepreneur — 149,99 $/mois · 1 499,90 $/an · 15 utilisateurs
STRIPE_PRICE_ENTREPRENEUR_MONTHLY=price_xxxxxxxxxxxxxpremonth
STRIPE_PRICE_ENTREPRENEUR_ANNUAL=price_xxxxxxxxxxxxxxxpreyear
# Croissance — 249,99 $/mois · 2 499,90 $/an · utilisateurs illimités
STRIPE_PRICE_CROISSANCE_MONTHLY=price_xxxxxxxxxxxxxcroimonth
STRIPE_PRICE_CROISSANCE_ANNUAL=price_xxxxxxxxxxxxxxxcroiyear

# Platform admin (Super Admin — uses existing Supabase service role)
# No extra env vars required. Grant super admin via SQL (see docs/PLATFORM_EXTENSIONS.md).
# Optional: override test email base when + addressing is unavailable (e.g. qa@yourdomain.com)
# PLATFORM_TEST_EMAIL_BASE=qa@yourdomain.com

# Les montants et les limites d'utilisateurs des paliers ne sont PAS des
# variables d'environnement : ils vivent dans src/lib/billing/tiers.ts.
# Ils servent à l'affichage — c'est le Price ID qui détermine le montant facturé.

# Essai gratuit appliqué à la création de l'abonnement (0 = aucun essai)
SUBSCRIPTION_TRIAL_DAYS=0

# Resend (Quote email delivery — optional, logs link to console if unset)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ConstructionIOS <noreply@votredomaine.com>
