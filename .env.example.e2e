# E2E test credentials — copy to .env.e2e or add to .env.local
# Prerequisites: Supabase configured, migrations 017-020 applied, ios123 promo seeded (018)
#
# globalSetup auto-provisions tenant + super admin when vars below are unset.
# Override only if you need a fixed super admin account already in platform_admins.

# Base URL (default http://localhost:3000)
# E2E_BASE_URL=http://localhost:3000

# Super Admin — optional override (default: auto-created e2e+superadmin{runId}@e2e.constructionios.test)
# When set, globalSetup ensures this account exists in platform_admins with E2E_TEST_PASSWORD.
E2E_SUPER_ADMIN_EMAIL=your-super-admin@example.com

# Shared password for all E2E accounts (tenant + super admin). Never commit production passwords.
E2E_TEST_PASSWORD=YourSecurePassword123!

# Optional: pre-existing tenant test account (globalSetup creates one if unset)
# E2E_TENANT_EMAIL=e2e-tenant@example.com
# E2E_TENANT_PASSWORD=YourSecurePassword123!

# Default password for auto-created E2E accounts when E2E_TEST_PASSWORD is unset
E2E_DEFAULT_PASSWORD=TestE2ePass123!
